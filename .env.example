# ============================================================
# AI News Agent 配置
# 复制此文件为 .env 并填写你的密钥
# ============================================================

# ---------- LLM ----------
# 支持 OpenAI / Kimi (Moonshot) / DeepSeek / 任何 OpenAI 兼容 API
OPENAI_API_KEY=sk-your-api-key
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL=gpt-4o-mini

# Concat AI Gateway（配置后优先于 OPENAI_*；仅在受控云环境注入 Token）
AI_GATEWAY_TOKEN=
AI_GATEWAY_BASE_URL=
AI_GATEWAY_BIZID=hunter
AI_GATEWAY_ABILITY_KEY=gcp-claude-sonnet-4-6

# Kimi 示例:
# OPENAI_API_KEY=sk-your-moonshot-key
# OPENAI_BASE_URL=https://api.moonshot.cn/v1
# OPENAI_MODEL=moonshot-v1-auto

# ---------- 翻译专用模型（可选）----------
# Key 和 BaseURL 默认复用 OPENAI_API_KEY / OPENAI_BASE_URL，只需指定模型名
# 若主 LLM 用 Kimi 等不擅长翻译的模型，可在此单独配置更强的翻译模型（如 gpt-4.1）
TRANSLATE_MODEL=gpt-4.1
TRANSLATE_API_KEY=
TRANSLATE_BASE_URL=

# ---------- Embedding（可选，默认复用 LLM 的 Key）----------
# 如果 LLM 服务商不提供 Embedding API（如 Kimi），可单独配置
EMBEDDING_API_KEY=
EMBEDDING_BASE_URL=
EMBEDDING_MODEL=text-embedding-3-small

# ---------- 数据源 ----------
# Reddit 默认关闭（企业网络常被拦截）；需要时设 ENABLE_REDDIT=true 或命令行传入 reddit
ENABLE_REDDIT=false
REDDIT_SUBREDDITS=LocalLLaMA,MachineLearning,artificial,OpenAI,ClaudeAI,singularity,ChatGPT,ChatGPTCoding,DeepSeek,StableDiffusion,Oobabooga,localLLM,aivideo
HN_MIN_SCORE=50

# 自定义 RSS 源（格式: name1=url1,name2=url2，会叠加在内置源之上）
# 内置源: OpenAI News, DeepMind, HuggingFace Blog, PyTorch, AWS Blog, Dev.to AI,
# Towards Data Science, InfoQ 中文, 掘金, ByteByteGo, Developers Digest, Kenashe
# Anthropic 无 RSS，由独立源 anthropic 采集（sitemap / 新闻列表）
# 示例: RSS_FEEDS=mistral=https://mistral.ai/feed
RSS_FEEDS=

# Twitter / Product Hunt 默认不启用（成本高）。需要时命令行传入 twitter / producthunt
# FIRECRAWL_API_KEY=
# TWITTER_LIST_URL=https://x.com/i/lists/1585430245762441216
# NITTER_MIRROR_URL=https://nitter.net
# PRODUCTHUNT_API_TOKEN=
# PRODUCTHUNT_MIN_VOTES=50

# GitHub Trending 去重天数；日报最多推荐 3 个高度相关项目
GITHUB_TRENDING_DEDUP_DAYS=3
GITHUB_TRENDING_MAX_ITEMS=3
HF_PAPERS_MIN_UPVOTES=5

# ---------- 数据库（可选，启用后解锁语义去重）----------
# 本地: postgresql://postgres:postgres@localhost:5432/ainews
# Neon(免费): 去 neon.tech 创建，自带 pgvector
POSTGRES_URL=

# ---------- 输出 ----------
OUTPUT_DIR=./output
REPORT_MODE=daily  # daily / weekly

# ---------- Git Push（服务器部署时必填）----------
# 方式一：SSH Key（推荐，见部署文档）
# SSH_KEY_PATH=~/.ssh/id_ed25519  # docker-compose 挂载路径
# 方式二：GitHub Token（HTTPS）
GIT_TOKEN=
GIT_REPO=wyh0626/ai-news-agent

# ---------- 异常告警 Webhook（可选）----------
# 飞书: https://open.feishu.cn/open-apis/bot/v2/hook/xxx
# 钉钉: https://oapi.dingtalk.com/robot/send?access_token=xxx
ALERT_WEBHOOK_URL=

# ---------- Webhook 推送（可选）----------
SLACK_WEBHOOK_URL=
DISCORD_WEBHOOK_URL=
FEISHU_WEBHOOK_URL=

# ---------- 飞书自建应用机器人（HTTP 回调接收群内 @）----------
# 自定义机器人 webhook 无法接收 @ 消息；这里必须使用企业自建应用凭据。
FEISHU_APP_ID=
FEISHU_APP_SECRET=
FEISHU_VERIFICATION_TOKEN=
FEISHU_ENCRYPT_KEY=
# 逗号分隔，只允许这些群触发；定时结果发送到 TARGET_CHAT_ID。
FEISHU_ALLOWED_CHAT_IDS=
FEISHU_TARGET_CHAT_ID=
FEISHU_TRIGGER_COOLDOWN_SECONDS=3600

# ---------- 阿里云 OSS（云端报告与幂等标记）----------
OSS_ENDPOINT=
OSS_RESOURCE_BUCKET=
OSS_ACCESS_KEY_ID=
OSS_ACCESS_KEY_SECRET=
OSS_PREFIX=ai-news-agent
OSS_CUSTOM_DOMAIN=

# ---------- 云服务 ----------
SERVICE_HOST=0.0.0.0
SERVICE_PORT=8080

# ---------- 邮件推送（可选）----------
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=
NEWSLETTER_RECIPIENTS=

# ---------- Pipeline ----------
MAX_ITEMS_PER_RUN=50
MAX_ITEMS_PER_SOURCE=15
ARXIV_MAX_ITEMS=5   # ArXiv 单独上限，避免论文占比过高（默认5条）
# RSS 博客变多后按 feed 保底，避免新源被挤掉（每个 feed 2–3 条）
MIN_ITEMS_PER_RSS_FEED=2
MAX_ITEMS_PER_RSS_FEED=3
TOP_K_FEATURED=10

# ---------- Profile 化评分 ----------
# 指定 profiles/<name>，或设为 auto 让 LLM 自动选择规则集
SCORING_PROFILE=tech-news
SCORING_PROFILES_DIR=profiles
SCORING_BATCH_SIZE=10
SCORING_MAX_CONCURRENT=3
SCORING_MAX_RETRIES=3
SCORING_MAX_ITEMS=20

LOG_LEVEL=INFO
